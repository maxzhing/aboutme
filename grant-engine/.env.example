# Grant Match Engine configuration.
# Every capability below is optional. Anything you leave unset is reported to the
# user as a gap in coverage — the system never substitutes a guess for a source
# it cannot reach.

# ---------------------------------------------------------------- server
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# ------------------------------------------------- language model (optional)
# Used only to interpret the applicant's own words and to read funder pages.
# Every fact it extracts must be backed by a quote found verbatim on the source
# page or it is discarded. Without a key, rule-based parsing is used instead.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# ----------------------------------------------- web search (pick ONE, optional)
# Required to discover foundations, state/local programs and corporate giving.
# Without one, results cover federal opportunities only.
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# TAVILY_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# SEARXNG_URL=http://localhost:8080     # self-hosted SearXNG instance, no key needed

# --------------------------------- federal source (no key required, on by default)
GRANTS_GOV_ENABLED=true
# GRANTS_GOV_ROWS=25

# ------------------------------------------------------------------ crawling
# Identify yourself honestly to the sites you fetch.
FETCH_USER_AGENT=GrantMatchEngine/1.0 (grant eligibility research; contact: you@example.com)
FETCH_RESPECT_ROBOTS=true
FETCH_PER_HOST_DELAY_MS=700
FETCH_CONCURRENCY=4

# ------------------------------------------------------------------ pipeline
STALE_AFTER_HOURS=72
MAX_CANDIDATES_TO_VERIFY=40
MAX_RESULTS=20
SEARCH_MAX_QUERIES=10

# -------------------------------------------------------------------- alerts
ALERTS_ENABLED=true
ALERT_INTERVAL_HOURS=24
ALERT_MATCH_THRESHOLD=75
