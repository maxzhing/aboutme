{
  "name": "stellify",
  "version": "1.0.0",
  "private": true,
  "description": "Stellify \u2014 a completely free, offline Digital SAT preparation platform in a single HTML file.",
  "scripts": {
    "build": "npm run validate:questions && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate:questions": "tsx scripts/validate-questions.ts --strict",
    "check:links": "tsx scripts/check-links.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.12.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
