# --- required -----------------------------------------------------------------
# Your API key. Read server-side only; it is never sent to the browser.
# Set the one that matches AXIOM_LLM_PROVIDER below.
ANTHROPIC_API_KEY=sk-ant-...

# --- provider -----------------------------------------------------------------
# anthropic (default) or openai.
# AXIOM_LLM_PROVIDER=anthropic

# Model used for every generation. Defaults to Claude Opus 5.
# AXIOM_MODEL=claude-opus-5

# --- openai (only read when AXIOM_LLM_PROVIDER=openai) -------------------------
# OPENAI_API_KEY=sk-...
# AXIOM_OPENAI_MODEL=gpt-5.6-terra
# OPENAI_ORG_ID=org-...
#
# Point this at anything that speaks the chat-completions API — Azure, a
# gateway, a local server — and the same provider code works unchanged.
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# `reasoning_effort` is sent by default. Compatible endpoints that reject the
# parameter need it switched off.
# AXIOM_OPENAI_EFFORT=off
#
# OpenAI's strict structured outputs cap schema size, and schemas past the cap
# fall back to JSON mode. These are the published limits; change them only if
# OpenAI does.
# AXIOM_OPENAI_SCHEMA_DEPTH=5
# AXIOM_OPENAI_SCHEMA_PROPERTIES=100

# --- optional -----------------------------------------------------------------
# PORT=8787
# HOST=0.0.0.0

# Independent second-pass review of generated questions. On by default.
# Set to "off" to trade quality for speed and cost.
# AXIOM_QC=on

# Concurrent upstream requests, retry budget and per-request timeout.
# AXIOM_CONCURRENCY=6
# AXIOM_MAX_RETRIES=4
# AXIOM_TIMEOUT_MS=600000

# Where state and uploads live.
# AXIOM_DB=./data/axiom.db
# AXIOM_UPLOADS=./uploads
# AXIOM_MAX_UPLOAD_BYTES=25165824

# debug | info | warn | error | silent
# AXIOM_LOG_LEVEL=info
